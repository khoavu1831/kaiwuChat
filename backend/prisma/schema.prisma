generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  email        String        @unique
  hashPassword String
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  friendOf     Friendship[]  @relation("FriendFriendships")
  sentRequests Friendship[]  @relation("SenderFriendships")
  friendships  Friendship[]  @relation("UserFriendships")
  messages     Message[]     @relation("UserMessages")
  participants Participant[]
  sessions     Session[]
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  senderId  Int
  status    String
  createdAt DateTime @default(now())
  friend    User     @relation("FriendFriendships", fields: [friendId], references: [id])
  sender    User     @relation("SenderFriendships", fields: [senderId], references: [id])
  user      User     @relation("UserFriendships", fields: [userId], references: [id])

  @@unique([userId, friendId])
  @@index([friendId], map: "Friendship_friendId_fkey")
  @@index([senderId], map: "Friendship_senderId_fkey")
}

model Conversation {
  id           Int           @id @default(autoincrement())
  type         String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  participants Participant[]
}

model Participant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  role           String       @default("member")
  lastSeenAt     DateTime?
  joinAt         DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId], map: "Participant_userId_fkey")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  type           String       @default("text")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("UserMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId], map: "Message_senderId_fkey")
}

model Session {
  id           String   @id @default(uuid())
  userId       Int
  refreshToken String   @unique @db.VarChar(512)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}
